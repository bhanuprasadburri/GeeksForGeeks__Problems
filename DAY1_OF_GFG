2.REPLACE ALL 0 WITH 5
You are given an integer n. You need to convert all zeroes of n to 5.
SOURCE CODE :
				class Solution {
					int convertfive(int num) {
							if(num==0) {
									return 5;
							}
							int res=0;
							while(num!=0) {
									int rem=num%10;
									if(rem==0) {
											rem=5;
									}
									res=res*10+rem;
									num/=10;
							}
							int sum=0;
							while(res>0) {
									int rem=res%10;
									sum=sum*10+rem;
									res/=10;
							}
							return sum;
					}
				}
PROBLEM LINK: https://www.geeksforgeeks.org/problems/replace-all-0s-with-5/1


